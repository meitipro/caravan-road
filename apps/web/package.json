{
  "name": "@caravan/web",
  "private": true,
  "version": "0.0.0",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src",
    "test": "vitest run --passWithNoTests",
    "test:sandbox": "vitest run --config vitest.sandbox.config.ts",
    "db:migrate": "tsx src/server/db/run-migrate.ts",
    "smoke:testnet": "tsx src/server/scripts/smoke-testnet.ts",
    "dev:reset": "node -e \"require('node:fs').rmSync('.data',{recursive:true,force:true});console.log('dev world reset (.data removed)')\""
  },
  "dependencies": {
    "@caravan/shared": "workspace:*",
    "@electric-sql/pglite": "0.5.13",
    "near-api-js": "7.4.0",
    "next": "^15.0.0",
    "next-auth": "5.0.0-beta.32",
    "pg": "^8.23.1",
    "qrcode-generator": "^2.0.4",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "swr": "^2.5.1",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.3.7",
    "@types/node": "^22.0.0",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.0.0",
    "eslint": "^9.39.5",
    "eslint-config-next": "^15.5.28",
    "near-sandbox": "0.3.4",
    "puppeteer-core": "^25.16.0",
    "tsx": "^4.23.15",
    "typescript": "^5.6.0",
    "vitest": "^2.1.9"
  }
}
