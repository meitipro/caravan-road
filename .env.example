# Variable names only. Never commit values; copy to .env.local and fill in.
# --- UI ---
NEXT_PUBLIC_MOCK=
NEXT_PUBLIC_MODE=
# --- NEAR (server, Phase 3; master plan 6.3) ---
GAME_MODE=
NEAR_NETWORK=
NEAR_RPC_URL=
CARAVAN_CONTRACT_ID=
RELAYER_ACCOUNT_ID=
RELAYER_PRIVATE_KEY=
OPERATOR_ACCOUNT_ID=
OPERATOR_PRIVATE_KEY=
TREASURY_ACCOUNT_ID=
TREASURY_PRIVATE_KEY=
KEY_ENC_SECRET=
# --- database, sessions, cron ---
DATABASE_URL=
AUTH_SECRET=
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=
AUTH_DISCORD_ID=
AUTH_DISCORD_SECRET=
CRON_SECRET=
# --- later phases ---
ONECLICK_JWT=
ONECLICK_USDC_ASSET_ID=
NEAR_AI_API_KEY=
# --- worker (Phase 5; see docs/WORKER.md) ---
MERCHANT_ACCOUNT_DASHT=
MERCHANT_ACCOUNT_MADAN=
MERCHANT_ACCOUNT_BANDAR=
MERCHANT_ACCOUNT_SHAHR=
KEY_DASHT=
KEY_MADAN=
KEY_BANDAR=
KEY_SHAHR=
NEAR_AI_MODEL=
NEAR_AI_BASE_URL=
NEAR_AI_RESPONSE_FORMAT=
WORKER_PERIOD_SECONDS=
WORKER_STAGGER_SECONDS=
WORKER_ID=
# --- local end-to-end dev backend (never in production; see docs/SERVER.md) ---
SERVER_BACKEND=
DEV_LOGIN=
DEV_TICK_SECONDS=
# --- testnet setup script (scripts/setup-testnet.mjs, docs/DEPLOY.md; names only, values stay in .env.local) ---
# ROOT_ACCOUNT_ID: the testnet account you created yourself; every other account id is derived from it.
ROOT_ACCOUNT_ID=
# ROOT_KEY_FILE: path to a local file holding the root account private key (never a value here, never argv).
ROOT_KEY_FILE=
OWNER_ACCOUNT_ID=
# OWNER_PRIVATE_KEY: full-access key of the owner account. Local machine only, never set it on a host.
OWNER_PRIVATE_KEY=
# Optional sizing overrides in NEAR (defaults are printed by `plan`).
FUND_OWNER_NEAR=
FUND_OPERATOR_NEAR=
FUND_RELAYER_NEAR=
FUND_MERCHANT_NEAR=
FUND_CONTRACT_NEAR=
KEY_ALLOWANCE_NEAR=
